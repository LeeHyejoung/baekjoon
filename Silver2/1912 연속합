n = int(input())
str = input()
array = str.split(" ")

sumArray = [0] * len(array)
sumArray[0] = int(array[0])

for i in range(1, len(array)):
    if (int(array[i]) <= sumArray[i - 1] + int(array[i])):
        sumArray[i] = sumArray[i - 1] + int(array[i])
    else:
        sumArray[i] = int(array[i])

print(max(sumArray))
